{
  "name": "rust-email",
  "version": "0.1.1",
  "description": "A library for creating email templates with React but for Rust Askama",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./askama": {
      "types": "./dist/askama.d.ts",
      "default": "./dist/askama.js"
    }
  },
  "scripts": {
    "build": "bunchee"
  },
  "keywords": [
    "email",
    "react",
    "email-templates"
  ],
  "author": "AprilNEA <github@sku.moe>",
  "license": "MIT",
  "dependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "@types/react": "*",
    "bunchee": "*",
    "typescript": "*"
  }
}