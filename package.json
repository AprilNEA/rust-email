{
  "name": "rust-email",
  "version": "0.1.4",
  "description": "A library for creating email templates with React but for Rust Askama",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./askama": {
      "types": "./dist/askama.d.ts",
      "import": "./dist/askama.js",
      "require": "./dist/askama.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunchee"
  },
  "keywords": [
    "email",
    "react",
    "email-templates"
  ],
  "author": "AprilNEA <github@sku.moe>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AprilNEA/rust-email.git"
  },
  "bugs": {
    "url": "https://github.com/AprilNEA/rust-email/issues"
  },
  "homepage": "https://github.com/AprilNEA/rust-email#readme",
  "dependencies": {
    "change-case": "^5.4.4",
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "@types/react": "*",
    "bunchee": "*",
    "typescript": "*"
  }
}